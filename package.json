{
  "name": "blackbox",
  "version": "1.0.0",
  "private": true,
  "description": "BlackBox — Resilient Operations Platform (Offline-First MERN Stack)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "vercel-build": "npm run build --prefix client",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "blackbox",
    "offline-first",
    "operations",
    "mern",
    "resilient"
  ],
  "author": "BlackBox Team",
  "license": "MIT"
}
